{
  "info": {
    "_postman_id": "61ceff8c-e22e-42b5-badd-2ef268b6e38e",
    "name": "Booking System API",
    "description": "End-to-end collection for the Seat Reservation Service. Run in order to exercise health, readiness, metrics, anonymous registration, show creation, reservation holds, idempotent replay, same-key/different-body rejection, confirmation, and cancellation. Override the base_url collection variable to switch environments.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://seat-booking-api-sm8u.onrender.com",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "show_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "reservation_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "idempotency_key",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health and observability",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/healthz",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "healthz"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"process is live\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/readyz",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "readyz"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"database is ready\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Prometheus metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/metrics",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "metrics"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"metrics endpoint responds\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.text()).to.include(\"http_requests_total\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reservation flow",
      "item": [
        {
          "name": "Register anonymous user",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"user registration returns a bearer token\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", body.token);",
                  "pm.collectionVariables.set(\"user_id\", body.user_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create show",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman demo {{$guid}}\",\n  \"price_paise\": 25000,\n  \"seats\": [\"A0\", \"A1\", \"A2\", \"A3\", \"A4\", \"A5\", \"A6\", \"A7\", \"A8\", \"A9\", \"A10\", \"A11\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/shows",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "shows"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"show is created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.collectionVariables.set(\"show_id\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get show inventory",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/shows/{{show_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "shows",
                "{{show_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"show inventory is readable\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const counts = pm.response.json().counts;",
                  "    pm.expect(counts.available + counts.held + counts.confirmed).to.eql(12);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reserve seat A0 (15-minute hold)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seats\": [\"A0\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/shows/{{show_id}}/reserve",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "shows",
                "{{show_id}}",
                "reserve"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"idempotency_key\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"reservation hold is created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.json().status).to.eql(\"held\");",
                  "});",
                  "pm.collectionVariables.set(\"reservation_id\", pm.response.json().reservation_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay same key and body",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seats\": [\"A0\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/shows/{{show_id}}/reserve",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "shows",
                "{{show_id}}",
                "reserve"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"same request replays the original reservation\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.json().reservation_id).to.eql(pm.collectionVariables.get(\"reservation_id\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reuse key with a different body (expected 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seats\": [\"A1\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/shows/{{show_id}}/reserve",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "shows",
                "{{show_id}}",
                "reserve"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"same key with a different body is rejected\", function () {",
                  "    pm.response.to.have.status(409);",
                  "    pm.expect(pm.response.text()).to.include(\"Idempotency key reused with different body\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm reservation",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/reservations/{{reservation_id}}/confirm",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "reservations",
                "{{reservation_id}}",
                "confirm"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"reservation is confirmed\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql(\"confirmed\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel reservation (releases seat)",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/reservations/{{reservation_id}}/cancel",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "reservations",
                "{{reservation_id}}",
                "cancel"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"reservation is cancelled\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql(\"cancelled\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
